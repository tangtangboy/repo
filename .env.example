# ---- 거래소 API 키. 계정별 접두사는 config.json accounts[].env_prefix (기본 = 거래소 이름 대문자).
#      공통: lake 전용 서브계정, 선물 주문·포지션 읽기/쓰기만, 출금·이체 권한 없음, IP 화이트리스트 = 서버 Elastic IP 하나.
#      값이 비어 있거나 PUT_ 플레이스홀더면 그 계정은 live 실행 불가(LIVE_DISABLED). 테스트는 실키를 절대 쓰지 않는다.

# Bybit (UTA, Contract Orders+Positions 읽기·쓰기). accounts 가 없는 v0.1 설정에서도 이 두 값으로 bybit 계정 하나를 만든다.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX (권한 Trade + Read). API 생성 시 정한 passphrase 가 필수 — 키가 있는데 passphrase 가 비면 설정 오류.
#      config 의 testnet=true 는 OKX "데모 트레이딩"(x-simulated-trading=1) 이며 데모용으로 따로 발급한 키를 넣는다.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Toobit (USDT-M 선물, LONG/SHORT 양방향 포지션 전용). 테스트넷 없음.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=

# ---- 수신 신호 검증용 공유 시크릿 (lake → 우리). TEST/LIVE 분리, 각 32바이트 이상. 없으면 해당 mode 신호는 503.
LAKE_SIGNAL_SECRET_TEST=
LAKE_SIGNAL_SECRET_LIVE=

# ---- 회신 서명용 시크릿 + 회신 URL (우리 → lake). TEST/LIVE 분리. URL이 비어 있으면 회신은 저장만 하고 전송하지 않음.
#      아래 네 값은 모든 계정의 기본값이다 (config.json accounts[].report=true 인 계정만 전송; 기본은 bybit 만).
LAKE_REPORT_SECRET_TEST=
LAKE_REPORT_SECRET_LIVE=
LAKE_REPORT_URL_TEST=
LAKE_REPORT_URL_LIVE=

# ---- 선택: 계정별 회신 덮어쓰기. LAKE_REPORT_URL_{MODE}_{NAME} / LAKE_REPORT_SECRET_{MODE}_{NAME}
#      NAME = accounts[].name 대문자, 영숫자 외 문자는 '_' (예: "okx-sub" → OKX_SUB). 비어 있으면 위 기본값 사용.
#      lake 가 거래소별 회신 스트림을 따로 받기로 합의되면(docs/REPLY_TO_LAKE.md §10) 여기에 채운다.
# LAKE_REPORT_URL_TEST_OKX=
# LAKE_REPORT_SECRET_TEST_OKX=
# LAKE_REPORT_URL_LIVE_OKX=
# LAKE_REPORT_SECRET_LIVE_OKX=
# LAKE_REPORT_URL_TEST_TOOBIT=
# LAKE_REPORT_SECRET_TEST_TOOBIT=
# LAKE_REPORT_URL_LIVE_TOOBIT=
# LAKE_REPORT_SECRET_LIVE_TOOBIT=

# ---- 운영자 관리 엔드포인트 토큰 (GET /state, POST /admin/*). 비어 있으면 관리 엔드포인트 비활성.
#      32바이트 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- 선택: 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
