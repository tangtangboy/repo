# ---- Bybit (lake 전용 계정 권장, 권한: Contract/UTA Orders+Positions 읽기·쓰기, 출금 금지, IP 화이트리스트 = 서버 Elastic IP)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- 수신 신호 검증용 공유 시크릿 (lake → 우리). TEST/LIVE 분리, 각 32바이트 이상. 없으면 해당 mode 신호는 503.
LAKE_SIGNAL_SECRET_TEST=
LAKE_SIGNAL_SECRET_LIVE=

# ---- 회신 서명용 시크릿 + 회신 URL (우리 → lake). TEST/LIVE 분리. URL이 비어 있으면 회신은 저장만 하고 전송하지 않음.
LAKE_REPORT_SECRET_TEST=
LAKE_REPORT_SECRET_LIVE=
LAKE_REPORT_URL_TEST=
LAKE_REPORT_URL_LIVE=

# ---- 운영자 관리 엔드포인트 토큰 (GET /state, POST /admin/*). 비어 있으면 관리 엔드포인트 비활성.
#      32바이트 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- 선택: 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
