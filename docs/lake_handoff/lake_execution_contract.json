    "semantic_validation": [
      "No unknown fields, duplicate JSON keys, nonfinite numbers, compressed bodies, or request bodies larger than 65536 bytes.",
      "observed_at_ms <= receive time + 5000 and <= ts + 5000; stored observed_at_ms must not decrease across the mode stream.",
      "sequence starts at 1 and increases globally within each mode, independently from outgoing per-position event_sequence. Persist sequence across restarts.",
      "Exact same report_id and raw bytes are idempotent; changed bytes conflict. All requests must pass the 60-second authentication window, including duplicates.",
      "A new report_id must not reuse a fill_id. Several reports may share event_id for partial fills and statuses, but position/strategy/leg/action identity must remain unchanged.",
      "A sequence gap marks live state inconsistent; the next consecutive complete snapshot reconciles the displayed current positions, not lost historical executions.",
      "Only a complete dedicated-account BTCUSDT snapshot can assert flat. Include all attributed strategy lots; reconcile lot sums to actual exchange positions before asserting complete.",
      "Do not mix position_idx 0 with 1/2 in a snapshot. One-way mode cannot have opposing long/short lots. Each position_id occurs once; updated_at_ms <= observed_at_ms.",
      "The receiver accepts remote attestations and does not independently query Bybit. If account scope or strategy attribution cannot be proven, do not send complete:true.",
      "Each fill report qty is incremental BTC fill quantity, not order size, not cumulative size, not percent. fill_price is actual incremental fill price.",
      "Every non-fill report must use qty:null, fill_price:null, fill_id:null. reason_code is a sanitized symbolic code, never a free-text vendor exception.",
      "Snapshot qty is remaining BTC size; entry_price is average actual entry; mark_price is actual venue mark or null. stop_loss:null means unconfirmed/unavailable; take_profit:null means unknown, [] means confirmed no TP orders.",
      "No implicit zero defaults, performance/PnL inference, local position changes inferred from fills, or external writes."
    ],
    "get_state_semantics": {
      "positions": "Current verified positions only; empty when not fresh.",
      "last_known_positions": "Last complete snapshot positions retained separately, including when stale/inconsistent.",
      "last_snapshot_observed_at_ms": "Observation time of last complete snapshot or null.",
      "last_snapshot_received_at_ms": "Local receipt time of last complete snapshot or null.",
      "positions_known": "True only when current state is fresh.",
      "flat": "True/false only when fresh; otherwise null.",
      "executions": "Latest 30 live reports for display only; freshness checks persist last position-changing sequence independently."
    },
    "freshness": {
